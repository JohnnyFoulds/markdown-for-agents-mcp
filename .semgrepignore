# Semgrep ignore — mirrors .gitignore patterns plus test files
# (test files excluded from production SAST; run semgrep separately on tests if desired)

node_modules/
dist/
coverage/
security-reports/

# Test files — SAST findings in test code are generally false positives
**/*.test.ts
**/*.spec.ts
**/__mocks__/
**/__fixtures__/

# Security scan scripts — these intentionally contain shell exec patterns
# (they ARE the scanners; flagging them would produce pure noise).
# install-playwright.js is shipped in package.json "files" and runs as
# postinstall — it is NOT excluded here so SAST covers the published surface.
scripts/scan-dast.mjs
scripts/scan-sast.mjs
scripts/scan-sca.mjs
scripts/scan-secrets.mjs
scripts/security-scan.mjs
scripts/install-security-tools.sh

# Generated / vendored
*.min.js
*.bundle.js

# Semgrep rule fixtures are tested via `semgrep --test`, not the main scan.
# They intentionally contain violation patterns so the rule fires — excluding
# them prevents false positives in the regular scan run.
security/semgrep/fixtures/
