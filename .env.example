# ─── Fetch ──────────────────────────────────────────────────────────────────
FETCH_TIMEOUT_MS=30000              # Timeout per fetch request (ms)
MAX_CONCURRENT_FETCHES=5            # Max parallel fetches in batch operations
MAX_REDIRECTS=10                    # Max redirect hops before error
MAX_CONTENT_LENGTH=100000           # Max content size (chars) before truncation

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                      # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=text                     # text | json

# ─── Cache ───────────────────────────────────────────────────────────────────
CACHE_MAX_BYTES=52428800            # Max in-memory cache size (bytes; default 50 MB)
CACHE_TTL_MS=900000                 # Cache TTL (ms; default 15 min)

# ─── Security / domain filtering ─────────────────────────────────────────────
USE_ALLOWLIST_MODE=false            # When true, only listed BLOCKLIST_DOMAINS are allowed
BLOCKLIST_DOMAINS=                  # Comma-separated domains to block (or allow in allowlist mode)
BLOCKLIST_URL_PATTERNS=             # Comma-separated URL patterns to block

# ─── Web search ──────────────────────────────────────────────────────────────
WEB_SEARCH_DEFAULT_TIMEOUT_MS=30000 # Default timeout for search requests (ms)
BRAVE_API_KEY=                      # Brave Search API key (Tier 1 provider)
SERPER_API_KEY=                     # Serper API key for Google SERP (Tier 1 provider)
SEARXNG_URL=                        # SearXNG instance URL (Tier 2 provider, self-hosted)
SEARCH_FANOUT_RESULTS=20            # Max URLs returned from search fan-out
SEARCH_DEFAULT_COUNTRY=za           # Default country code for results (ISO 3166-1 alpha-2; za = South Africa)
SEARCH_DEFAULT_LANGUAGE=en          # Default language code for results (BCP 47)
LOG_REDACT_QUERIES=true             # Hash query text in logs (POPIA compliance; set false for debug)
SEARXNG_ENGINE_PROFILE=clean        # clean (ToS-safe engines only) | full (includes Google/Bing/DDG — check ToS before enabling)
SEARCH_CACHE_TTL_MS=3600000         # Search result cache TTL (ms; default 1 hour). Reduces engine load at scale.

# ─── File download ───────────────────────────────────────────────────────────
DOWNLOAD_TIMEOUT_MS=60000           # Timeout for file downloads (ms)
MAX_DOWNLOAD_BYTES=52428800         # Max download size (bytes; default 50 MB)

# ─── HTTP client ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOST_RPS=0           # Max requests/second per host. 0 = unlimited
RATE_LIMIT_BURST=10                 # Token-bucket burst size
RATE_LIMIT_MAX_WAIT_MS=30000        # Max time to wait for a rate-limit token (ms)
RESPECT_ROBOTS_TXT=false            # Honour robots.txt crawl rules
ROBOTS_ON_ERROR=allow               # allow | deny — behaviour when robots.txt fetch fails (4xx/5xx/timeout)
HTTP_DEFAULT_CHARSET=utf-8          # Fallback charset when not declared in response

# ─── Proxy ───────────────────────────────────────────────────────────────────
HTTP_PROXY_URL=                     # Outbound proxy for all tiers (canonical var)
PLAYWRIGHT_PROXY=                   # Legacy alias for HTTP_PROXY_URL
PLAYWRIGHT_PROXY_BYPASS=            # Comma-separated hosts that bypass the proxy
PROXY_PINS=                         # JSON array of proxy URLs for round-robin rotation
                                    # e.g. '["http://p1:3128","http://p2:3128"]'
                                    # Overrides HTTP_PROXY_URL when set

# ─── Render ladder ───────────────────────────────────────────────────────────
BROWSER_POOL_SIZE=1                 # Number of warm browser instances
RENDER_MAX_CONCURRENCY=4            # Max simultaneous renders
RENDER_SETTLE_MS=2000               # Max time to wait for JS settle after domcontentloaded
BROWSER_MAX_JOBS=50                 # Recycle browser after this many contexts
RENDER_BLOCK_RESOURCES=true         # Block images/CSS/fonts/media (reduces memory ~60-70%)
BROWSER_DISABLE_DEV_SHM=false       # Set true only when /dev/shm is not properly sized
BROWSER_CHANNEL=chromium            # chromium (default) | chrome-headless-shell (leaner, no screenshots)
STEALTH_ENABLED=false               # Use playwright-extra stealth plugin for Tier 3
RENDER_ESCALATE_THRESHOLD=0.45      # Escalation score threshold (0–1); lower = escalate sooner
RENDER_MIN_TEXT_CHARS=400           # Visible text below this triggers escalation signal
RENDER_TIER_MEMO_DECAY_PROB=0.05    # Probability of re-probing a cached tier decision
                                    # Requires: npm install playwright-extra puppeteer-extra-plugin-stealth

# Tier 2 — Lightpanda (AGPL-3.0, run as a separate sidecar process)
# docker-compose.yml starts lightpanda/browser:0.3.7 as a sidecar and sets these automatically.
# For local dev without Docker: run `docker run -d -p 9222:9222 lightpanda/browser:0.3.7`
LIGHTPANDA_ENABLED=false
LIGHTPANDA_CDP_URL=ws://127.0.0.1:9222
LIGHTPANDA_MAX_FAILURE_RATE=0.4     # Circuit-breaker threshold (fraction)

# ─── Reranker ────────────────────────────────────────────────────────────────
RERANK_BACKEND=none                 # none | local (ONNX in worker thread) | tei
RERANK_MODEL=Xenova/bge-reranker-base
RERANK_DTYPE=q8                     # q8 is required for CPU ONNX; fp16 fails on onnxruntime-node
RERANK_DEVICE=cpu
RERANK_TEI_URL=                     # TEI endpoint URL when RERANK_BACKEND=tei

# ─── Stores ──────────────────────────────────────────────────────────────────
STORE_BACKEND=auto                  # auto | memory | sqlite | redis
                                    # auto = memory for stdio, sqlite for HTTP
STORE_SQLITE_PATH=crawl.db          # SQLite file path (STORE_BACKEND=sqlite)
STORE_REDIS_URL=                    # Redis URL (STORE_BACKEND=redis)
                                    # e.g. redis://localhost:6379

# ─── Crawl engine ────────────────────────────────────────────────────────────
CRAWL_MAX_PAGES=1000
CRAWL_MAX_DEPTH=10
CRAWL_MAX_CONCURRENCY=5
CRAWL_QUEUE_LEASE_MS=30000          # Lease duration per work item (ms); expired → reclaimed
CRAWL_WORKER_POLL_MS=1000           # Worker idle poll interval (ms)

# ─── Process role ────────────────────────────────────────────────────────────
MCP_ROLE=server                     # server | worker | both

# ─── HTTP server ─────────────────────────────────────────────────────────────
HTTP_PORT=3000                      # Expose HTTP server on this port (omit for stdio)
MCP_AUTH_TOKEN=                     # Bearer token required on all HTTP requests
                                    # Store in Secrets Manager / SSM in production — never in env plain-text
MCP_HTTP_MODE=stateless             # stateless (N-replica safe) | session (requires Ingress affinity)

# ─── Graceful drain ──────────────────────────────────────────────────────────
SHUTDOWN_DRAIN_MS=5000              # Wait for LB Endpoints propagation before closing (ms)
SHUTDOWN_TIMEOUT_MS=30000           # Max time to wait for in-flight requests to finish (ms)

# ─── Metrics / OTel ──────────────────────────────────────────────────────────
METRICS_BIND_PORT=                  # Expose /metrics on a separate port (omit = same port as HTTP_PORT)
OTEL_ENABLED=false                  # Enable OpenTelemetry tracing (requires @opentelemetry/sdk-node)

# ─── SOCKS5 gateway ──────────────────────────────────────────────────────────
# Ingress listener — lets AI Studio (or any SOCKS5-aware client) reach this
# server without a native MCP transport. Off by default.
SOCKS5_LISTEN_ENABLED=false
SOCKS5_LISTEN_HOST=127.0.0.1        # Bind address (127.0.0.1 = loopback only)
SOCKS5_LISTEN_PORT=1080             # Listener port
SOCKS5_LISTEN_MODE=tunnel           # tunnel (recommended) | intercept (MITM, requires CA)
SOCKS5_LISTEN_AUTH=none             # none | userpass
SOCKS5_LISTEN_USER=                 # Username (SOCKS5_LISTEN_AUTH=userpass)
SOCKS5_LISTEN_PASS=                 # Password (SOCKS5_LISTEN_AUTH=userpass)
# Required only when SOCKS5_LISTEN_MODE=intercept (not recommended — see SECURITY.md)
SOCKS5_INTERCEPT_CA_CERT=           # Path to CA certificate PEM
SOCKS5_INTERCEPT_CA_KEY=            # Path to CA private key PEM

# Upstream SOCKS5 proxy — used by all three render tiers.
# Solves the Chromium SOCKS5 credential limitation (microsoft/playwright#10567):
# point Chromium at the loopback listener above, which then adds credentials
# upstream. Direct socks5://user:pass@… in Playwright doesn't work.
SOCKS5_UPSTREAM_URL=                # e.g. socks5://proxy.corp.example:1080
SOCKS5_UPSTREAM_USER=               # Injected by the loopback listener (Chromium workaround)
SOCKS5_UPSTREAM_PASS=               # Same
